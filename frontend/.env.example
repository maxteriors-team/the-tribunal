# The Tribunal frontend environment template.
# Copy to frontend/.env.local for local development.

# Backend API origin used by Next.js rewrites and WebSocket helpers.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional billing page display price. Escape the literal dollar for Next.js dotenv expansion.
NEXT_PUBLIC_PLAN_PRICE=\$297/month

# Optional Sentry browser/server DSN. Leave blank to disable local reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Optional Sentry source-map upload token for CI/release builds.
SENTRY_AUTH_TOKEN=

# Optional Playwright target. Leave blank to let npm run e2e start Next.js locally.
PLAYWRIGHT_BASE_URL=

# Optional seeded user for the single explicit login smoke test.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Parallel authenticated specs require pre-provisioned worker accounts. Include
# the literal {worker} placeholder so each worker gets a separate refresh session.
E2E_USER_EMAIL_TEMPLATE=

# Local/dev only: let self-contained specs provision throwaway worker users.
E2E_ALLOW_PROVISIONING=0

# Optional password for provisioned users; a test-only default is used when blank.
E2E_PROVISION_PASSWORD=

# Playwright generates this run identifier; set it only for deterministic debugging.
E2E_RUN_ID=